# Application
POSTGRES_DB=cjcrsg_social_manager
POSTGRES_USER=social_manager
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://social_manager:change-me@localhost:5432/social_manager?schema=public

# Storage (bind-mounted directory for v1 media)
STORAGE_ROOT=/data/social-manager

# n8n
N8N_HOST=n8n.localhost
N8N_ENCRYPTION_KEY=change-me

# Internal API signing (HMAC-SHA256 shared secret)
INTERNAL_API_SECRET=change-me

# Session cookies
APP_KEY=change-me
