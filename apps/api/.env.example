# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Database
DATABASE_URL=postgresql://social_manager:social_manager@localhost:5432/social_manager?schema=public

# Sessions
SESSION_COOKIE_NAME=sm_session
SESSION_LIFETIME=30

# Storage driver (local only in v1)
STORAGE_DRIVER=local
STORAGE_ROOT=/data/social-manager

# Seed the initial admin (used by `node ace db:seed` / `pnpm db:seed`)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me